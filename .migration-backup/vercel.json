{
  "buildCommand": "pnpm install && pnpm --filter @workspace/prince-nitya run build",
  "outputDirectory": "artifacts/prince-nitya/dist/public",
  "installCommand": "pnpm install",
  "functions": {
    "api/chat.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
